# Copy to .env (never commit .env). Values below are for LOCAL DEVELOPMENT ONLY and match
# the backend dev-profile defaults, so the backend also runs from an IDE without any env vars.

# PostgreSQL
DB_NAME=pakkaplay
DB_USERNAME=pakkaplay
DB_PASSWORD=pakkaplay
DB_PORT=5432

# Redis
REDIS_PASSWORD=pakkaplay
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081

# Web (nginx serving the Angular build)
WEB_PORT=8081

# --- Production only (docker-compose.prod.yml) ---
# BACKEND_IMAGE=ghcr.io/<org>/pakkaplay-backend:<version>
# WEB_IMAGE=ghcr.io/<org>/pakkaplay-web:<version>
# APP_VERSION=<version>
# JWT secrets are introduced in Phase 2 (JWT_SECRET).
